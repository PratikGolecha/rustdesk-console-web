server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # API requests - reverse proxy to backend
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Browser (web) client bootstrap script: pre-seeds ID server / key / API server
    # (the static client requests this absolute path from its index.html)
    location = /webclient-config/index.js {
        proxy_pass ${BACKEND_URL}/api/web-client/config.js;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Browser (web) client static assets, fetched by scripts/fetch-web-client.sh.
    # Must not fall back to the console SPA, and must not get the 1y immutable
    # cache below (the Flutter service worker and index.html change on updates).
    location ^~ /webclient/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    # SPA fallback - serve index.html for client-side routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
